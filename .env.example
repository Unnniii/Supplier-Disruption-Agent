# Copy to .env and fill in. .env is gitignored - never commit it.

# Default: Gemini free tier. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# Model backend: gemini (free tier) | ollama (local, free) | claude (paid) | fake (tests)
SDA_PROVIDER=gemini
# SDA_MODEL=gemini-3.1-flash-lite      # check the exact name in AI Studio if this 404s

# The cap: the run stops after this many model calls (the offline full scan makes 80; real models take extra turns)
SDA_MAX_LLM_CALLS=200

# Only if SDA_PROVIDER=ollama
# OLLAMA_URL=http://localhost:11434
# SDA_MODEL=qwen3:8b

# Only if SDA_PROVIDER=claude (paid)
# ANTHROPIC_API_KEY=
